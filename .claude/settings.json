{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/scripts/planning.py:*)",
      "Bash(go:*)",
      "Bash(gofmt:*)",
      "Bash(bazel:*)",
      "Bash(bazelisk:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(docker:*)",
      "Bash(k6:*)",
      "Bash(curl:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git push -u origin ci-check/:*)",
      "Bash(git push origin ci-check/:*)",
      "Bash(git push origin --delete ci-check/:*)",
      "Bash(git show:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch:*)",
      "Bash(git worktree:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch:*)",
      "Bash(git stash list:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh workflow:*)",
      "Bash(make:*)",
      "Bash(golangci-lint:*)",
      "Bash(buf:*)",
      "Bash(mongosh:*)",
      "Bash(brew install:*)",
      "Bash(bash .claude/scripts/:*)",
      "Bash(python3:*)",
      "Bash(jq:*)",
      "Bash(openssl:*)",
      "Bash(lsof:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(pgrep:*)",
      "Bash(ps:*)",
      "Bash(caffeinate:*)",
      "Bash(tmux:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(test:*)",
      "Bash(which:*)",
      "Bash(command -v:*)",
      "Bash(date:*)",
      "Bash(nc:*)",
      "Bash(wait:*)",
      "Bash(xargs:*)",
      "Bash(tee:*)",
      "Bash(cd:*)",
      "Bash(rm:*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push origin --delete main:*)",
      "Bash(git push origin :main:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf .git:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/planning.py\" guard",
            "timeout": 15,
            "statusMessage": "snaptix guard: kiểm tra quy trình task"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/planning.py\" guard-bash",
            "timeout": 15,
            "statusMessage": "snaptix guard: kiểm tra commit/push"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/planning.py\" auto stop-hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
