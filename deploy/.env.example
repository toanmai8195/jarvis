# Biến cho deploy/docker-compose.yml (P0-T02).
# Compose chạy được khi chưa có .env: mọi biến đều có mặc định bằng đúng giá trị
# dưới đây. Muốn đổi → `cp deploy/.env.example deploy/.env` rồi sửa (.env bị .gitignore).

# PostgreSQL — dùng chung user/password cho core và analytics.
# CORE_DATABASE_URL=postgres://snaptix:snaptix@localhost:5432/core
# ANALYTICS_DATABASE_URL=postgres://snaptix:snaptix@localhost:5433/analytics
POSTGRES_USER=snaptix
POSTGRES_PASSWORD=snaptix
POSTGRES_CORE_DB=core
POSTGRES_ANALYTICS_DB=analytics
POSTGRES_CORE_PORT=5432
POSTGRES_ANALYTICS_PORT=5433

# MongoDB (không bật auth) — MONGODB_URI=mongodb://localhost:27017/snaptix
MONGODB_PORT=27017

# Redis (không mật khẩu) — REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Observability
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
# Grafana: đăng nhập ẩn danh, quyền Admin
GRAFANA_PORT=3100
