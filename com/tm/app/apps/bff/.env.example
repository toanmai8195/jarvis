# bff không tự đọc .env — nạp trước khi chạy: set -a; . ./.env; set +a
# Bắt buộc: URL mongodb:// hoặc mongodb+srv://
MONGODB_URI=mongodb://localhost:27017/snaptix
# Cổng HTTP, số nguyên 1..65535 (mặc định 3000)
BFF_PORT=3000
# Địa chỉ listen (mặc định 0.0.0.0)
BFF_HOST=0.0.0.0
# trace | debug | info | warn | error | fatal (mặc định info)
BFF_LOG_LEVEL=info
# Gốc URL của core; URL http:// hoặc https:// có host, không userinfo (mặc định http://localhost:8080).
# GET /healthz?deep=1 gọi {CORE_BASE_URL}/readyz, hạn 2 s.
CORE_BASE_URL=http://localhost:8080

# OpenTelemetry (nạp qua --import ./dist/instrumentation.js, xem local-setup.md)
# OTLP/HTTP tới otel-collector; URL http:// hoặc https:// có host (mặc định http://localhost:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Mặc định service.name=bff, service.namespace=snaptix → Prometheus job="snaptix/bff"
# OTEL_SERVICE_NAME=bff
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# true → không export trace/metric, bff vẫn chạy
# OTEL_SDK_DISABLED=false
# Chu kỳ gửi span / metric (ms), mặc định 5000 / 60000; đặt nhỏ khi thử cục bộ
# OTEL_BSP_SCHEDULE_DELAY=500
# OTEL_METRIC_EXPORT_INTERVAL=2000
