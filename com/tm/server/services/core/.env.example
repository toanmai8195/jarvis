# core — biến môi trường (P0-T07). Sao chép thành .env rồi sửa khi cần.
# Mật khẩu dưới đây là mật khẩu local mặc định của deploy/docker-compose.yml.

# Bắt buộc: DSN PG core (pgx). Rỗng/thiếu → core thoát ngay với log ERROR.
CORE_DATABASE_URL=postgres://snaptix:snaptix@localhost:5432/core?sslmode=disable

# Địa chỉ HTTP host:port. Mặc định :8080 (mọi interface — Prometheus trong
# container scrape qua host.docker.internal:8080).
CORE_HTTP_ADDR=:8080

# Mức log: debug | info | warn | error (không phân biệt hoa thường). Mặc định info.
CORE_LOG_LEVEL=info
