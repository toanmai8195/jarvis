load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//tools/rules:com_tm_container.bzl", "com_tm_go_image")

go_library(
    name = "server_lib",
    srcs = [
        "main.go",
        "shutdown.go",
    ],
    importpath = "github.com/toanmai8195/snaptix/com/tm/server/services/core/cmd/server",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/otelx",
        "//services/core/internal/config",
        "//services/core/internal/httpx",
        "@com_github_exaring_otelpgx//:otelpgx",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@io_opentelemetry_go_otel//:otel",
    ],
)

com_tm_go_image(
    name = "server",
    embed = [":server_lib"],
    image = "core-server",
    visibility = ["//visibility:public"],
)

go_test(
    name = "server_test",
    srcs = [
        "shutdown_telemetry_test.go",
        "shutdown_test.go",
    ],
    embed = [":server_lib"],
)
